{
  "manifest_version": 3,
  "name": "KKU Plan Tools",
  "version": "2.4",
  "description": "Reveal hidden rows, extract plan data, and export timetable to Excel",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://registration.kku.edu.sa/kku/ui/student/student_plan/index/forwardAllPlanIndex.faces*"],
    "js": ["plan.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KKU Plan Tools"
  }
}
